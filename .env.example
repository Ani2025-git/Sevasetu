# ==============================================================================
# Seva Setu — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' in your local environment.
# NEVER commit your actual '.env' file or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Flask)
# ------------------------------------------------------------------------------
# Flask application environment: 'development' or 'production'
FLASK_ENV=development
FLASK_DEBUG=true

# Server port (default 5000 for local development)
PORT=5000

# Secret key used by Flask for session signing and CSRF protection
# In production, generate a strong random 32+ character string
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-min

# JWT secret key for signing user authentication tokens
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-secret-key

# JWT expiration in hours (default: 24)
JWT_EXPIRATION_HOURS=24

# Database connection URL:
# - Local SQLite fallback (leave blank or comment out to use local sqlite:///sevaqueue.db)
# - PostgreSQL / Neon (production):
#   postgresql://<username>:<password>@<neon-host>/<database>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-sample-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Queue observation staleness threshold in minutes (default: 30)
STALE_THRESHOLD_MINUTES=30

# Allowed CORS origins (comma-separated or '*' for open access during development)
# Production example: https://sevasetu-flax-kappa.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
# Location: frontend/.env (or set in Vercel project environment settings)
# Base URL of the backend Flask API
# Local dev: http://localhost:5000/api (or leave unset to use Vite dev proxy)
# Production: https://sevasetu-mb4e.onrender.com/api
VITE_API_BASE_URL=https://sevasetu-mb4e.onrender.com/api
